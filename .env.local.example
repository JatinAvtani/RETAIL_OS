# Copy to .env.local. No accounts, no signup, works offline against docker-compose.yml.
# DATABASE_URL (superuser) is for running migrations (pnpm --filter @retailos/db db:migrate) —
# never the app's own runtime connection, which must stay RLS-scoped. apps/api reads
# APP_DATABASE_URL first (falling back to DATABASE_URL only if APP_DATABASE_URL is unset), so set
# APP_DATABASE_URL explicitly to retailos_app when both are present in the same shell/session, or
# `pnpm --filter @retailos/api dev` will silently run against the superuser and bypass RLS.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retailos
APP_DATABASE_URL=postgresql://retailos_app:retailos_app_local_only@localhost:5432/retailos
# apps/worker's own cross-tenant SWEEPS (outbox relay, briefing schedule poll, lot-expiry sweep,
# negative-stock sweep — anything reading/writing across every org in one query) use
# `retailos_sweeper`, never the superuser: BYPASSRLS without also granting CREATE/ALTER/DROP or role
# management, so a sweep bug is contained to ordinary table access. Falls back to DATABASE_URL
# (superuser) if unset, so a misconfigured environment still runs rather than crashing outright —
# set this explicitly for `pnpm --filter @retailos/worker dev` to actually exercise the
# least-privileged role locally.
SWEEP_DATABASE_URL=postgresql://retailos_sweeper:retailos_sweeper_local_only@localhost:5432/retailos
# 16379, not 6379 — docker-compose.yml publishes Redis on the host as 16379 because Windows
# reserves the 6373-6472 range for its own dynamic port allocation, so nothing can bind 6379 there.
# The container-internal port is still 6379; only the host mapping differs. These two values must
# match docker-compose.yml's published port or every queue/session connection fails with
# ECONNREFUSED. CI is different on purpose: its Redis service publishes the standard 6379 and sets
# no REDIS_URL at all, so it uses the code's own `?? 'redis://localhost:6379'` default. This file
# is never present in CI (.env.local is gitignored), so the two cannot conflict.
REDIS_URL=redis://localhost:16379
TEST_REDIS_URL=redis://localhost:16379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# apps/web (:3000) and apps/api (:3001) CORS + client wiring.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Free tier, no card. Covers both OCR (vision) and LLM work.
# GEMINI_API_KEY=

# Google OAuth 2.0 client (Testing mode, free — console.cloud.google.com > APIs & Services > Credentials).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Square OAuth (sandbox app, free, no card — developer.squareup.com > Applications).
# SQUARE_APPLICATION_ID=
# SQUARE_APPLICATION_SECRET=
# SQUARE_REDIRECT_URI=http://localhost:3001/integrations/square/callback
# SQUARE_ENVIRONMENT=sandbox

# Symmetric key for encrypting POS OAuth tokens at rest (AES-256-GCM, packages/pos/token-encryption.ts).
# Deviates from spec 13's "KMS-managed key" — no-card/no-cost constraint rules out a real cloud KMS.
# Any long random string works locally; a real deployment should use a properly generated secret.
# POS_TOKEN_ENCRYPTION_KEY=

# Postmark inbound-parse webhook Basic Auth credentials (no real Postmark account/domain exists for
# this project — the route is real, tested against Postmark's documented payload shape, but nothing
# calls it in production). Any values work locally; a real deployment configures Postmark's webhook
# URL as https://<user>:<pass>@yourhost/webhooks/inbound-email.
# POSTMARK_WEBHOOK_USERNAME=
# POSTMARK_WEBHOOK_PASSWORD=
